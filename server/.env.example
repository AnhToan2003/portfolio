# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/portfolio

# JWT — generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Admin account (used by seed:admin and server startup)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS — comma-separated allowed frontend origins
CLIENT_URL=http://localhost:5173

# Email — Phase 2 (Nodemailer + Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
